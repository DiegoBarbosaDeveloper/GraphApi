meta {
  name: 05 - Eliminar orden
  type: graphql
  seq: 5
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation EliminarOrden($id: ID!) {
    eliminarOrden(id: $id)
  }
}

body:graphql:vars {
  {
    "id": "00000000-0000-4000-8000-000000000002"
  }
}

docs {
  Devuelve true si la orden no tiene pedidos ni pagos.
  Si tiene dependencias, responde con un error de conflicto.
}