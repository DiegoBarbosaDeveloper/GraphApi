meta {
  name: 02 - Obtener usuario por id
  type: graphql
  seq: 2
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  query ObtenerUsuario($id: ID!) {
    usuario(id: $id) {
      id
      nombre
      email
      telefono
      activo
      ordenes {
        id
        estado
        total
      }
      pedidos {
        id
        producto
      }
      creadoEn
      actualizadoEn
    }
  }
}

body:graphql:vars {
  {
    "id": "00000000-0000-0000-0000-000000000001"
  }
}

docs {
  Sustituye el id por el UUID de un usuario existente.
}