meta {
  name: 06 - Orden inexistente en pedido
  type: graphql
  seq: 6
}

post {
  url: http://localhost:3000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation CrearPedidoInvalido($input: CrearPedidoInput!) {
    crearPedido(input: $input) {
      id
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "producto": "Producto huerfano",
      "cantidad": 1,
      "precioUnitario": 10,
      "usuarioId": "00000000-0000-0000-0000-000000000001",
      "ordenId": "99999999-9999-9999-9999-999999999999"
    }
  }
}

docs {
  Esperado: error mencionando la orden inexistente, con mensaje que contiene "Orden con id".
}